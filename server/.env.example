# ---------------------------------------------------------------------------
# Retrac checkout — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# sandbox = developer testing, no real money.  live = real purchases.
PAYPAL_MODE=sandbox

PORT=3000
BRAND_NAME=Odium
SITE_URL=http://localhost:3000

# The price charged, independent of what the browser sends.
PRICE=3.00
CURRENCY=USD

# --- PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
# Optional: webhook id, needed only for the /api/paypal/webhook route
PAYPAL_SANDBOX_WEBHOOK_ID=

# --- PayPal live app (same page, toggle to Live)
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Payment notification email
#
# Sender AND recipient are natevisionn@gmail.com for now. When the domain
# mailbox exists, change MAIL_TO (and MAIL_FROM once SMTP for the domain is set).
#
# Gmail SMTP requires an App Password, not the account password:
#   1. Google Account -> Security -> 2-Step Verification (must be on)
#   2. https://myaccount.google.com/apppasswords -> create "Retrac"
#   3. paste the 16 character password into SMTP_PASS
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=natevisionn@gmail.com
SMTP_PASS=
MAIL_FROM=natevisionn@gmail.com
MAIL_TO=natevisionn@gmail.com

# Set only if the site is hosted on a different origin than the API.
CORS_ORIGIN=
