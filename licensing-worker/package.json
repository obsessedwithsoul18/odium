{
  "name": "retrac-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: PayPal orders, capture and receipt email for the Retrac storefront.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:init": "wrangler d1 execute retrac-orders --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute retrac-orders --local --file schema.sql",
    "db:info": "wrangler d1 info retrac-orders"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
